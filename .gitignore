# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

.venv/
.env
.env.*
!.env.example
.python-version
.pytest_cache/
.mypy_cache/
.cache/
.coverage
htmlcov/

.vscode/
.idea/
.DS_Store
.ipynb_checkpoints/

data/llm-alignments/*.json
!data/llm-alignments/.gitkeep
results/alignment-evaluation/*.json
!results/alignment-evaluation/.gitkeep

# Data protection — prevent accidental leakage of patient/clinical data
# Block common data formats by default (allowlist specific files below)
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.sqlite
*.db

# Audio files (should never be committed)
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# Model checkpoints (too large, download separately)
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
checkpoints/
BLEURT-20/
BLEURT-20-D12/
ClinicalBLEURT/

# Allowlisted data files — only these CSVs are tracked
!llm_judge/dataset/primock_data_final_outcomes.csv
!metrics/data/primock_metrics_subset.csv

# Temporary/scratch files
/tmp/
scratch/
*.tmp
