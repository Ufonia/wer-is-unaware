OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=meta-llama/Meta-Llama-3.1-405B-Instruct

GCP_PROJECT_ID=
GCP_LOCATION=

AWS_REGION=

# BARTScore — ParaBank2-finetuned checkpoint (.pth)
# Download from https://github.com/neulab/BARTScore (Google Drive link in README)
BARTSCORE_CHECKPOINT=metrics/learned_semantic_lightweight/bart_score.pth

# BLEURT — Install: uv sync --extra bleurt
# Standard BLEURT uses the test checkpoint bundled with the package (no config needed).
# Clinical BLEURT requires a separate checkpoint (manual download):
#   https://github.com/abachaa/EvaluationMetrics-ACL23/blob/main/ClinicalBLEURT/README.md
CLINICAL_BLEURT_CHECKPOINT=/path/to/ClinicalBLEURT